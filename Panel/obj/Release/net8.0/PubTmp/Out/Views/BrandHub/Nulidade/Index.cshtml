@model Panel.Models.BrandsHub.NulidadeRequestModel

@{
    ViewData["Title"] = "Petição de Nulidade ao Registro de Marca";
}

@if (ViewBag.Prompt != null)
{

    <div class="nk-content">
        <div class="container-fluid">
            <div class="nk-content-inner">
                <div class="nk-content-body">
                    <div class="nk-block">
                        <div class="card">
                            <div class="card-inner">

                                <!-- Abas -->
                                <ul class="nav nav-tabs" id="oposicaoTabs" role="tablist">
                                    <li class="nav-item" role="presentation">
                                        <a class="nav-link active" id="peticao-tab" data-bs-toggle="tab" href="#peticao" role="tab" aria-controls="peticao" aria-selected="true">Petição Gerada</a>
                                    </li>
                                    <li class="nav-item" role="presentation">
                                        <a class="nav-link" id="historico-tab" data-bs-toggle="tab" href="#historico" role="tab" aria-controls="historico" aria-selected="false">Histórico do Chat</a>
                                    </li>
                                </ul>

                                <!-- Conteúdo das abas -->
                                <div class="tab-content pt-4" id="oposicaoTabsContent">
                                    <!-- Aba 1: Petição -->
                                    <div class="tab-pane fade show active" id="peticao" role="tabpanel" aria-labelledby="peticao-tab">
                                        <h4 class="nk-block-title page-title">Petição de Nulidade Gerada</h4>
                                        <p class="text-muted mb-4">Revise o conteúdo abaixo. Caso deseje, você pode adicionar observações e reenviar para gerar um novo conteúdo baseado nisso.</p>

                                        <!-- Conteúdo do prompt -->
                                        <div id="prompt-box" class="border rounded p-3 mb-3">
                                            @Html.Raw(ViewBag.Prompt.Replace("```html", "").Replace("```", ""))
                                        </div>

                                        <!-- Formulário de observações -->
                                        <form asp-action="NulidadeRepost" asp-controller="BrandHub" method="post">
                                            <input type="hidden" name="PromptAnterior" value="@ViewBag.Prompt" />
                                            <input type="hidden" name="ChatIAId" value="@ViewBag.ChatId" />

                                            <div class="form-group">
                                                <label for="Observacoes">Observações adicionais</label>
                                                <textarea class="form-control" name="Observacoes" rows="5" style="min-height:215px" placeholder="Inclua sugestões, correções ou informações complementares..."></textarea>
                                                <small class="text-muted">Essas observações serão consideradas para gerar um novo conteúdo.</small>
                                            </div>

                                            <button type="submit" class="btn btn-primary mt-3">Reenviar com Observações</button>
                                        </form>
                                    </div>

                                    <!-- Aba 2: Histórico -->
                                    <div class="tab-pane fade" id="historico" role="tabpanel" aria-labelledby="historico-tab">
                                        <div id="chat-history" class="">
                                            <h4 class="nk-block-title page-title">Oráculo Leão</h4>
                                            <!-- Campo oculto para manter o chatIAId -->
                                            <input type="hidden" id="chatIAId" value="@ViewBag.ChatIAId" />

                                            <div id="chat-box" class="border rounded p-3 mb-3">
                                                <!-- Renderiza as mensagens já existentes -->
                                                @foreach (var msg in Model.ListMessages.messageChatResponses.Where(b => b.IsChatAnswer == true))
                                                {
                                                    // Converte o timestamp Unix para data legível
                                                    var unixTime = 0L;
                                                    long.TryParse(msg.Time, out unixTime);
                                                    var formattedTime = DateTimeOffset.FromUnixTimeSeconds(unixTime)
                                                    .LocalDateTime.ToString("dd MMM, yyyy h:mm tt");
                                                    <div class="message @(msg.IsChatAnswer ? "bot" : "user")">
                                                        <strong>@(msg.IsChatAnswer ? "Oráculo Leão:" : "Você:")</strong> @Html.Raw(msg.Message)
                                                        <br /><small class="text-muted" style="font-size: 0.8em;">@formattedTime</small>
                                                    </div>
                                                }
                                            </div>
                                        </div>
                                    </div>
                                </div> <!-- tab-content -->

                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>



}
else
{
    <div class="nk-content ">

        <div class="nk-content-inner">
            <div class="nk-block-head">
                <div class="nk-block-between">
                    <div class="nk-block-head-content">
                        <h4 class="nk-block-title fw-normal">Nulidades de Marcas</h4>
                        <div class="nk-block-des">
                            <nav>
                                <ul class="breadcrumb breadcrumb-arrow">
                                    <li class="breadcrumb-item"><a href="~/">Dashboard</a></li>
                                    <li class="breadcrumb-item"><a href="~/">Hub de Marcas</a></li>
                                    <li class="breadcrumb-item"><a href="/brandhub?typed=nulidade">Nulidades</a></li>
                                    <li class="breadcrumb-item active">Nulidade</li>
                                </ul>
                            </nav>
                        </div>
                    </div>

                </div>
            </div>
            <div class="nk-content-body">

                <div class="nk-block">
                    <div class="card">
                        <div class="card-inner">
                            <h4 class="nk-block-title page-title">Petição de Nulidade ao Registro de Marca</h4>
                            <p class="text-muted mb-4">Gerencie e automatize o contencioso administrativo de marcas de forma simples e eficiente.</p>

                            <form action="/brandhub/nulidade" method="post">
                                <div id="task-type-container" class="row">
                                    <!-- Número do Registro -->
                                    <div class="col-sm-4">
                                        <div class="form-field-container">
                                            <span class="information-span">
                                                <label class="form-label" for="RegistroNumero">Número do Registro</label>
                                            </span>
                                            <input type="text" class="round-borders form-control" id="RegistroNumero" name="RegistroNumero" step="any" required>
                                            <div class="field-help-text">Número do processo administrativo em 9 dígitos...</div>
                                        </div>
                                    </div>

                                    <!-- Marca Registrada -->
                                    <div class="col-sm-4">
                                        <div class="form-field-container">
                                            <span class="information-span">
                                                <label class="form-label" for="RegistroMarca">Marca Registrada</label>
                                            </span>
                                            <input type="text" class="round-borders form-control" id="RegistroMarca" name="RegistroMarca" step="any" required>
                                            <div class="field-help-text">Sinal distintivo objeto da nulidade...</div>
                                        </div>
                                    </div>

                                    <!-- Classe do Registro -->
                                    <div class="col-sm-4">
                                        <div class="form-field-container">
                                            <span class="information-span">
                                                <label class="form-label" for="RegistroClasse">Classe do Registro</label>
                                            </span>
                                            <input type="text" class="round-borders form-control" id="RegistroClasse" name="RegistroClasse" step="any" required>
                                            <div class="field-help-text">Classificação Internacional Nice vigente...</div>
                                        </div>
                                    </div>

                                    <!-- Especificação do Registro -->
                                    <div class="col-sm-12">
                                        <div class="form-field-container">
                                            <span class="information-span">
                                                <label class="form-label" for="RegistroEspecificacao">Especificação do Registro</label>
                                            </span>
                                            <textarea class="round-borders form-control" id="RegistroEspecificacao" name="RegistroEspecificacao" required></textarea>
                                            <div class="field-help-text">Lista literal e completa dos produtos/serviços...</div>
                                        </div>
                                    </div>

                                    <!-- Titular do Registro -->
                                    <div class="col-sm-4">
                                        <div class="form-field-container">
                                            <span class="information-span">
                                                <label class="form-label" for="RegistroTitular">Titular do Registro</label>
                                            </span>
                                            <input type="text" class="round-borders form-control" id="RegistroTitular" name="RegistroTitular" step="any" required>
                                            <div class="field-help-text">Denominação completa do titular...</div>
                                        </div>
                                    </div>

                                    <!-- Data da Concessão -->
                                    <div class="col-sm-12">
                                        <div class="form-field-container">
                                            <span class="information-span">
                                                <label class="form-label" for="RegistroDataConcessao">Data da Concessão</label>
                                            </span>
                                            <input type="date" class="round-borders form-control" id="RegistroDataConcessao" name="RegistroDataConcessao" required>
                                            <div class="field-help-text">Data da publicação da concessão...</div>
                                        </div>
                                    </div>

                                    <!-- RPI da Concessão -->
                                    <div class="col-sm-4">
                                        <div class="form-field-container">
                                            <span class="information-span">
                                                <label class="form-label" for="RegistroRpi">RPI da Concessão</label>
                                            </span>
                                            <input type="text" class="round-borders form-control" id="RegistroRpi" name="RegistroRpi" step="any" required>
                                            <div class="field-help-text">Número da Revista da Propriedade Industrial...</div>
                                        </div>
                                    </div>

                                    <!-- Registro Anterior -->
                                    <div class="col-sm-4">
                                        <div class="form-field-container">
                                            <label class="form-label" for="AnteriorRegistro">Registro Anterior</label>
                                            <input type="text" class="round-borders form-control" id="AnteriorRegistro" name="AnteriorRegistro" step="any">
                                            <div class="field-help-text">Número do processo da marca anterior...</div>
                                        </div>
                                    </div>

                                    <!-- Marca Anterior -->
                                    <div class="col-sm-4">
                                        <div class="form-field-container">
                                            <label class="form-label" for="AnteriorMarca">Marca Anterior</label>
                                            <input type="text" class="round-borders form-control" id="AnteriorMarca" name="AnteriorMarca" step="any">
                                            <div class="field-help-text">Identificação completa da marca anterior...</div>
                                        </div>
                                    </div>

                                    <!-- Classe Anterior -->
                                    <div class="col-sm-4">
                                        <div class="form-field-container">
                                            <label class="form-label" for="AnteriorClasse">Classe Anterior</label>
                                            <input type="text" class="round-borders form-control" id="AnteriorClasse" name="AnteriorClasse" step="any">
                                            <div class="field-help-text">Classificação Nice da marca anterior...</div>
                                        </div>
                                    </div>

                                    <!-- Especificação Anterior -->
                                    <div class="col-sm-12">
                                        <div class="form-field-container">
                                            <label class="form-label" for="AnteriorEspecificacao">Especificação Anterior</label>
                                            <textarea class="round-borders form-control" id="AnteriorEspecificacao" name="AnteriorEspecificacao"></textarea>
                                            <div class="field-help-text">Produtos/serviços protegidos pela marca anterior...</div>
                                        </div>
                                    </div>

                                    <!-- Titular Anterior -->
                                    <div class="col-sm-4">
                                        <div class="form-field-container">
                                            <label class="form-label" for="AnteriorTitular">Titular Anterior</label>
                                            <input type="text" class="round-borders form-control" id="AnteriorTitular" name="AnteriorTitular" step="any" required>
                                            <div class="field-help-text">Nome completo do requerente da nulidade...</div>
                                        </div>
                                    </div>

                                    <!-- Data Depósito Anterior -->
                                    <div class="col-sm-12">
                                        <div class="form-field-container">
                                            <label class="form-label" for="AnteriorDataDeposito">Data Depósito Anterior</label>
                                            <input type="date" class="round-borders form-control" id="AnteriorDataDeposito" name="AnteriorDataDeposito">
                                            <div class="field-help-text">Data do protocolo da marca anterior...</div>
                                        </div>
                                    </div>

                                    <!-- Tipo de Reprodução -->
                                    <div class="col-sm-4">
                                        <div class="form-field-container">
                                            <label class="form-label" for="ComparacaoTipo">Tipo de Reprodução</label>
                                            <input type="text" class="round-borders form-control" id="ComparacaoTipo" name="ComparacaoTipo" step="any">
                                            <div class="field-help-text">Especificação técnica do tipo de violação alegada...</div>
                                        </div>
                                    </div>

                                    <!-- Elementos Similares -->
                                    <div class="col-sm-12">
                                        <div class="form-field-container">
                                            <label class="form-label" for="ComparacaoElementos">Elementos Similares</label>
                                            <textarea class="round-borders form-control" id="ComparacaoElementos" name="ComparacaoElementos"></textarea>
                                            <div class="field-help-text">Análise detalhada dos elementos coincidentes...</div>
                                        </div>
                                    </div>

                                    <!-- Análise Visual -->
                                    <div class="col-sm-12">
                                        <div class="form-field-container">
                                            <label class="form-label" for="ComparacaoVisual">Análise Visual <span class="text-muted">[campo opcional]</span></label>
                                            <textarea class="round-borders form-control" id="ComparacaoVisual" name="ComparacaoVisual"></textarea>
                                            <div class="field-help-text">Descrição técnica das semelhanças gráficas...</div>
                                        </div>
                                    </div>

                                    <!-- Análise Fonética -->
                                    <div class="col-sm-12">
                                        <div class="form-field-container">
                                            <label class="form-label" for="ComparacaoFonetica">Análise Fonética</label>
                                            <textarea class="round-borders form-control" id="ComparacaoFonetica" name="ComparacaoFonetica"></textarea>
                                            <div class="field-help-text">Análise da pronúncia, cadência e sonoridade...</div>
                                        </div>
                                    </div>

                                    <!-- Precedentes -->
                                    <div class="col-sm-12">
                                        <div class="form-field-container">
                                            <label class="form-label" for="Precedentes">Precedentes <span class="text-muted">[campo opcional]</span></label>
                                            <textarea class="round-borders form-control" id="Precedentes" name="Precedentes"></textarea>
                                            <div class="field-help-text">Citação de decisões anteriores do INPI...</div>
                                        </div>
                                    </div>

                                    <!-- Má-Fé -->
                                    <div class="col-sm-12">
                                        <div class="form-field-container">
                                            <label class="form-label" for="MaFe">Má-Fé <span class="text-muted">[campo opcional]</span></label>
                                            <textarea class="round-borders form-control" id="MaFe" name="MaFe"></textarea>
                                            <div class="field-help-text">Elementos que evidenciam intenção de aproveitamento parasitário...</div>
                                        </div>
                                    </div>

                                    <!-- Danos ao Mercado -->
                                    <div class="col-sm-12">
                                        <div class="form-field-container">
                                            <label class="form-label" for="DanosMercado">Danos ao Mercado <span class="text-muted">[campo opcional]</span></label>
                                            <textarea class="round-borders form-control" id="DanosMercado" name="DanosMercado"></textarea>
                                            <div class="field-help-text">Caracterização dos prejuízos causados pela coexistência das marcas...</div>
                                        </div>
                                    </div>

                                    <!-- Decisões Anteriores -->
                                    <div class="col-sm-12">
                                        <div class="form-field-container">
                                            <label class="form-label" for="DecisoesAnteriores">Decisões Anteriores <span class="text-muted">[campo opcional]</span></label>
                                            <textarea class="round-borders form-control" id="DecisoesAnteriores" name="DecisoesAnteriores"></textarea>
                                            <div class="field-help-text">Jurisprudência administrativa e judicial relevante...</div>
                                        </div>
                                    </div>
                                </div>

                                <button type="submit" class="btn btn-primary">Enviar</button>
                            </form>


                        </div>
                    </div>
                </div>
            </div>
        </div>

    </div>
}



@if (ViewBag.Prompt != null)
{
    <style>

        /* Caixa de chat */
        #chat-box {
            background-color: #ffffff;
            border: 1px solid #e0e0e0;
            border-radius: 8px;
            padding: 15px;
            height: 70vh;
            overflow-y: auto;
        }

        /* Estilo base das mensagens */
        .message {
            display: inline-block;
            padding: 10px 15px;
            margin: 5px 0;
            max-width: 70%;
            border-radius: 15px;
            word-wrap: break-word;
        }

            /* Mensagens do usuário */
            .message.user {
                background-color: #dcf8c6;
                text-align: right;
                float: right;
                border-bottom-right-radius: 0;
                clear: both;
            }

            /* Mensagens do ChatBot */
            .message.bot {
                background-color: #f1f0f0;
                text-align: left;
                float: left;
                border-bottom-left-radius: 0;
                clear: both;
            }

            /* Limpeza dos floats após cada mensagem */
            .message::after {
                content: "";
                display: table;
                clear: both;
            }

        /* Indicador de "digitando" */
        .typing {
            font-style: italic;
            color: #888;
        }

    </style>

    @section scripts {
    <script type="text/javascript">
        $(document).ready(function () {
            $('#oposicaoTabs a').on('click', function (e) {
                e.preventDefault()
                $(this).tab('show')
            });
        });
    </script>
    }
}

