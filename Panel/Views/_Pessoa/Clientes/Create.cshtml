@model Painel.Models.Pages.ClientesPage

@using Painel.Models.Components
@{
    ContentConfig bread = Model.ContentConfig;
    bread.Id = Model.Cliente.Id;
}

@{
    ViewData["Title"] = "Cadastro de " + bread.Tela;
}
<form action="@bread.Post" method="post">
    <div class="nk-block nk-block-lg">

        @await Html.PartialAsync("~/Views/Shared/Structure/_HeadContent.cshtml", bread)

        <div class="row g-gs">
            <div class="col-lg-8">
                <div class="card card-bordered">
                    <div class="card-inner">


                        <div class="row g-4">
                            <input type="hidden" name="Id" value="@Model.Cliente.Id" />
                            @Html.HiddenFor(model => model.Cliente.Excluido)
                            @Html.ValidationSummary(true)
                            @Html.AntiForgeryToken()

                            @if (Model.Page.acNome == true)
                            {
                                @await Html.PartialAsync("~/Views/Objetos/_Nome.cshtml", Model.Cliente)
                            }


@* 
                            @await Html.PartialAsync("~/Views/Components/_TextField.cshtml",
                                     new Painel.Models.Components.TextField("Razão Social", "RazaoSocial", Model.Cliente.RazaoSocial, "", "", "", "text", "", 12))

                            @await Html.PartialAsync("~/Views/Components/_TextField.cshtml",
                                     new Painel.Models.Components.TextField("CNPJ", "CNPJ", Model.Cliente.CNPJ, "", "", "", "text", "", 12))

                            @await Html.PartialAsync("~/Views/Components/_TextField.cshtml",
                                     new Painel.Models.Components.TextField("Email", "Email", Model.Cliente.Email, "", "", "", "email", "", 12))

                            @await Html.PartialAsync("~/Views/Components/_TextField.cshtml",
                                     new Painel.Models.Components.TextField("Telefone Empresa", "TelefoneEmpresa", Model.Cliente.TelefoneEmpresa, "", "", "", "text", "phone-mask", 12))

                            @await Html.PartialAsync("~/Views/Components/_TextField.cshtml",
                                     new Painel.Models.Components.TextField("Whatsapp Empresa", "WhatsappEmpresa", Model.Cliente.WhatsappEmpresa, "", "", "", "text", "phone-mask", 12))
 *@
                            @if (Model.Page.acAtivo == true)
                            {
                                @await Html.PartialAsync("~/Views/Objetos/_Ativo.cshtml", Model.Cliente)
                            }

                            @await Html.PartialAsync("~/Views/Components/_FormActions.cshtml")

                        </div>



                    </div>
                </div>
                <div class="card">
                    <div class="card-inner">
                        <div class="row g-4">
                            @await Html.PartialAsync("~/Views/Components/_TextField.cshtml",
                                     new Painel.Models.Components.TextField("CEP", "CEP", Model.Cliente.CEP, "", "", "", "text", "", 3))
                            @await Html.PartialAsync("~/Views/Components/_TextField.cshtml",
                                     new Painel.Models.Components.TextField("Logradouro", "Logradouro", Model.Cliente.Logradouro, "", "", "", "text", "", 9))
                            @await Html.PartialAsync("~/Views/Components/_TextField.cshtml",
                                     new Painel.Models.Components.TextField("Número", "Numero", Model.Cliente.Numero, "", "", "", "text", "", 6))
                            @await Html.PartialAsync("~/Views/Components/_TextField.cshtml",
                                     new Painel.Models.Components.TextField("Complemento", "Complemento", Model.Cliente.Complemento, "", "", "", "text", "", 6))
                            @await Html.PartialAsync("~/Views/Components/_TextField.cshtml",
                                     new Painel.Models.Components.TextField("Cidade", "Cidade", Model.Cliente.Cidade, "", "", "", "text", "", 4))
                            @await Html.PartialAsync("~/Views/Components/_TextField.cshtml",
                                     new Painel.Models.Components.TextField("Estado", "Estado", Model.Cliente.Estado, "", "", "", "text", "", 4))
                            @await Html.PartialAsync("~/Views/Components/_TextField.cshtml",
                                     new Painel.Models.Components.TextField("Pais", "Pais", Model.Cliente.Pais, "", "", "", "text", "", 4))
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-lg-4">
                <div class="card card-bordered">
                    <div class="card-inner">
                        <div class="row g-gs">

                            @await Html.PartialAsync("~/Views/Components/_TextField.cshtml",
                                     new Painel.Models.Components.TextField("Link Externo", "Website", Model.Cliente.Website, "", "", "", "text", "", 12))

                            @if (Model.Page.acCategoria == true)
                            {
                                @await Html.PartialAsync("~/Views/Objetos/Propriedade/_Categoria.cshtml", Model.Cliente)
                            }

                            @if (Model.Page.acOrdem == true)
                            {
                                @await Html.PartialAsync("~/Views/Objetos/_Ordem.cshtml", Model.Cliente)
                            }

                            @if (Model.Page.acImagem == true)
                            {
                                @await Html.PartialAsync("~/Views/Objetos/_Imagem.cshtml", Model.Cliente)
                                @await Html.PartialAsync("~/Views/Objetos/_ImagemAlt.cshtml", Model.Cliente)
                            }

                            @if (Model.Page.acThumbnail == true)
                            {
                                @await Html.PartialAsync("~/Views/Objetos/_Thumbnail.cshtml", Model.Cliente)
                                @await Html.PartialAsync("~/Views/Objetos/_ThumbnailAlt.cshtml", Model.Cliente)
                            }

                        </div>
                    </div>
                </div>
                <div class="card">
                    <div class="card-inner">
                        <div class="row g-4">
                            @await Html.PartialAsync("~/Views/Components/_TextField.cshtml",
                                     new Painel.Models.Components.TextField("Responsável", "NomeResponsavel", Model.Cliente.NomeResponsavel, "", "", "", "text", "", 12))

                            @await Html.PartialAsync("~/Views/Components/_TextField.cshtml",
                                     new Painel.Models.Components.TextField("CPF", "CPFResponsavel", Model.Cliente.CPFResponsavel, "", "", "", "text", "cpf-mask", 12))

                            @await Html.PartialAsync("~/Views/Components/_TextField.cshtml",
                                     new Painel.Models.Components.TextField("Whatsapp Responsável", "WhatsappResponsavel", Model.Cliente.WhatsappResponsavel, "", "", "", "text", "phone-mask", 12))

                            @await Html.PartialAsync("~/Views/Components/_TextField.cshtml",
                                     new Painel.Models.Components.TextField("Email Responsável", "EmailResponsavel", Model.Cliente.EmailResponsavel, "", "", "", "email", "", 12))
                        </div>
                    </div>

                </div>
                <div class="card">
                    <div class="card-inner">
                        <div class="row g-4">
                            @await Html.PartialAsync("~/Views/Components/_TextField.cshtml",
                                     new Painel.Models.Components.TextField("Facebook", "Facebook", Model.Cliente.Facebook, "", "", "", "text", "", 12))

                            @await Html.PartialAsync("~/Views/Components/_TextField.cshtml",
                                     new Painel.Models.Components.TextField("Instagram", "Instagram", Model.Cliente.Instagram, "", "", "", "text", "", 12))

                            @await Html.PartialAsync("~/Views/Components/_TextField.cshtml",
                                     new Painel.Models.Components.TextField("Linkedin", "Linkedin", Model.Cliente.Linkedin, "", "", "", "text", "", 12))

                            @await Html.PartialAsync("~/Views/Components/_TextField.cshtml",
                                     new Painel.Models.Components.TextField("Website", "Website", Model.Cliente.Website, "", "", "", "text", "", 12))
                        </div>
                    </div>
                </div>
            </div>
        </div>

    </div>


</form>



@section Scripts {
    <script src="~/lib/helpers/ViaCEP.js"></script>
}