@model Painel.Models.Components.ContentConfig
<ul class="nav nav-tabs">

	@if (Model.NavTabsConfig is not null && Model.NavTabsConfig.ShowTabs is true)
	{
		if (Model.NavTabsConfig.ShowContentDetailItem is true)
		{
			<li class="nav-item">
				<a class="nav-link" data-toggle="tab" href="javascript:void(0);">
					<em class="icon ni ni-property"></em><span>Conteúdo</span>
				</a>
			</li>
		}
		else
		{
			if (Model.Id > 0)
			{
				if (Model.Post != null && Model.Post.Length > 1)
				{
					<li class="nav-item">
						<a class="nav-link" href="@Model.Post/@Model.Id">
							<em class="icon ni ni-property"></em>
							<span>Conteúdo</span>
						</a>
					</li>
				}
			}
		}

		if (Model.NavTabsConfig.ShowImageItem is true)
		{
			if (Model.Table is not null && Model.Table.Length > 1 && Model.Id > 0)
			{
				<li class="nav-item" style="">
					<a class="nav-link" href="/imagens?tab=@Model.Table&id=@Model.Id">
						<em class="icon ni ni-img"></em>
						<span>Imagens</span>
					</a>
				</li>
			}

		}

		if (ViewData["Area"] != null && ViewData["Area"].ToString() == "Variations")
		{
			if (Model.Table is not null && Model.Table.Length > 1 && Model.Id > 0)
			{
				<li class="nav-item" style="">
					<a class="nav-link" href="/products/variations?id=@Model.Id">
						<em class="icon ni ni-files"></em>
						<span>Variações</span>
					</a>
				</li>
			}
		}
		else
		{
			if (Model.Table is not null && Model.Table.Length > 1 && Model.Table == "Products" && Model.Id > 0)
			{
				<li class="nav-item" style="">
					<a class="nav-link" href="/products/variations?id=@Model.Id">
						<em class="icon ni ni-files"></em>
						<span>Variações</span>
					</a>
				</li>
			}
		}

		if (Model.NavTabsConfig.ShowFileItem is true)
		{
			if (Model.Table is not null && Model.Table.Length > 1 && Model.Id > 0)
			{
				<li class="nav-item" style="">
					<a class="nav-link" href="/arquivos?tab=@Model.Table&id=@Model.Id">
						<em class="icon ni ni-files"></em>
						<span>Arquivos</span>
					</a>
				</li>
			}
		}

		if (Model.NavTabsConfig.ShowUsersJobTask is true)
		{

			<li class="nav-item" style="">
				<a class="nav-link" href="/jobtasks/usuarios/@Model.Id">
					<em class="icon ni ni-task"></em>
					<span>Usuários</span>
				</a>
			</li>

		}

		if (Model.NavTabsConfig.ShowJobTasksItem is true)
		{
			<li class="nav-item" style="">
				<a class="nav-link" href="/projects/tasks/@Model.Id">
					<em class="icon ni ni-task"></em>
					<span>Tarefas</span>
				</a>
			</li>
		}


		if (Model.DetailRoute != null && Model.DetailRoute.Length > 5)
		{
			<li class="nav-item">
				<a class="nav-link" href="@Model.DetailRoute/@Model.Id">
					<em class="icon ni ni-search"></em>
					<span>Detalhe</span>
				</a>
			</li>
		}

	}
	else
	{
		@if (Model.IsContentTime == true)
		{
			<li class="nav-item">
				<a class="nav-link active" data-toggle="tab" href="javascript:void(0);">
					<em class="icon ni ni-property"></em><span>Conteúdo</span>
				</a>
			</li>
		}
		else
		{
			<li class="nav-item">
				<a class="nav-link" href="@Model.Post/@Model.Id">
					<em class="icon ni ni-property"></em><span>Conteúdo</span>
				</a>
			</li>
		}


		@if (Model.Id > 0)
		{
			if (Model.DetailRoute != null && Model.DetailRoute.Length > 5)
			{
				<li class="nav-item">
					<a class="nav-link" href="@Model.DetailRoute/@Model.Id">
						<em class="icon ni ni-search"></em>
						<span>Conteúdo Post</span>
					</a>
				</li>
			}
		}

	@* 	@if (Model.TabSection == true)
		{
			<li class="nav-item">
				<a class="nav-link" href="/section?Owner=@Model.OwnerType&OwnerId=@Model.OwnerId">
					<em class="icon ni ni-search"></em>
					<span>Seções</span>
				</a>
			</li>
		} *@
	}



</ul>