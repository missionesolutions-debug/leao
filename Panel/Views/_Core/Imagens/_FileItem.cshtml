@model Data.Models.Core.Imagem
@using Framework.Tools;

<div class="col-sm-6 col-lg-4 col-xxl-3">
    <div class="gallery gallery-content card card-bordered">
        <div class="gallery-images">
            <img class="w-100 rounded" width="300" height="300" style="object-fit:cover;" src="@Model.Url" alt="">
        </div>
        <div class="image-overlay">
            <ul>
                <li>
                    <a href="javascript:void(0);" class="btn-open-imagem-edit" data-toggle="modal" data-target="#modalForm"
                       data-tags="@Model.FileTags"
                       data-alt="@Model.Alt" data-ddd="@Model.Url"
                       data-name="@Model.FileName"
                       data-id="@Model.Id"
                       data-DescriptionFile="@Model.DescriptionFile"><em class="icon ni ni-edit"></em></a>
                </li>
                <li>
                    <form method="post" id="form-@Model.Id" action="@String.Format("{0}{1}","/imagens/delete?Id=",Model.Id)">
                        <button type="button" onclick="callDelete(this,@Model.Id);" style="border:none;background-color:transparent;padding:0" class="file-dl-toast" title="Deletar Registro"><em class="icon ni ni-trash"></em></button>
                    </form>
                </li>
            </ul>
        </div>
    </div>
</div>
