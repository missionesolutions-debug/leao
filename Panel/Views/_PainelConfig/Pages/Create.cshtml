@model Data.Models.PainelConfig.Page
@{
	ViewData["Title"] = "Cadastro de Pages";
}
@using Painel.Models.Components
@{
	ContentConfig bread = new ContentConfig()
	{
		Route = "/pages",
		Post = "/pages/create",
		Tela = "Pages",
		Backplace = "Lista",
		Obs = "Preencha os campos abaixo para criar um novo registro"
	};


}

<div class="nk-block nk-block-lg">

	@await Html.PartialAsync("~/Views/Shared/Contents/_HeadContentCreate.cshtml", bread)
	<form action="@bread.Post" method="post">
		<div class="row g-gs">
			<div class="col-lg-7">
				<div class="card card-bordered">
					<div class="card-inner">
						@Html.HiddenFor(model => model.Id)
						@Html.HiddenFor(model => model.Guid)
						@Html.HiddenFor(model => model.Excluido)
						@Html.ValidationSummary(true)
						@Html.AntiForgeryToken()

						<div class="row g-gs">
							@await Html.PartialAsync("~/Views/Components/_TextField.cshtml",
								new Painel.Models.Components.TextField("Nome", "Nome", Model.Nome, "", "required", "", "text", "", 12))

							@await Html.PartialAsync("~/Views/Components/_SelectField.cshtml",
								new Painel.Models.Components.TextField("Menu", "MenuId", Model.MenuId > 0 ? Model.MenuId.ToString() : "", "", "required", "", "", "form-select", 12))

							@await Html.PartialAsync("~/Views/Components/_TextField.cshtml",
								new Painel.Models.Components.TextField("Route", "Route", Model.Route, "", "required", "", "text", "", 12))

							@await Html.PartialAsync("~/Views/Components/_TextField.cshtml",
								new Painel.Models.Components.TextField("Delete Route", "DeleteRoute", Model.DeleteRoute, "", "", "", "text", "", 12))

							@await Html.PartialAsync("~/Views/Components/_TextField.cshtml",
								new Painel.Models.Components.TextField("Detail Route", "DetailRoute", Model.DetailRoute, "", "", "", "text", "", 12))

							@await Html.PartialAsync("~/Views/Components/_TextField.cshtml",
								new Painel.Models.Components.TextField("Post", "Post", Model.Post, "", "", "", "text", "", 12))

							@await Html.PartialAsync("~/Views/Components/_TextField.cshtml",
								new Painel.Models.Components.TextField("Tela", "Tela", Model.Tela, "", "", "", "text", "", 12))

							@await Html.PartialAsync("~/Views/Components/_TextField.cshtml",
								new Painel.Models.Components.TextField("Backplace", "Backplace", Model.Backplace, "", "", "", "text", "", 12))

							@await Html.PartialAsync("~/Views/Components/_TextField.cshtml",
								new Painel.Models.Components.TextField("RoleGate", "RoleGate", Model.RoleGate, "", "required", "PowerUser, ContentCreator, Business, ProductOwner, Ecommerce", "text", "", 12))

							@await Html.PartialAsync("~/Views/Components/_TextField.cshtml",
								new Painel.Models.Components.TextField("Obs", "Obs", Model.Obs, "", "", "", "text", "", 12))

							@await Html.PartialAsync("~/Views/Components/_TextField.cshtml",
								new Painel.Models.Components.TextField("TableAction", "TableAction", Model.TableAction, "", "required", "", "text", "", 12))

							@await Html.PartialAsync("~/Views/Components/_TextField.cshtml",
								new Painel.Models.Components.TextField("SVG Icon", "SVGIcon", Model.SVGIcon, "", "", "", "text", "", 12))

							@await Html.PartialAsync("~/Views/Components/_TextCheck.cshtml",
								new Painel.Models.Components.CheckField("", "", "Ativo", "Ativo", Model.Id == 0 ? true : Model.Ativo == true ? true : false, "", "required", "", "text", "", 12))


							@await Html.PartialAsync("~/Views/Components/_FormActions.cshtml")
						</div>
					</div>
				</div>
			</div>
			<div class="col-lg-5">
				<div class="row g-gs">
					<div class="col-lg-12">
						<div class="card card-bordered">
							<div class="card-inner">
								<div class="row g-gs">
									@await Html.PartialAsync("~/Views/Components/_TextCheck.cshtml",
										new Painel.Models.Components.CheckField("", "", "Nav Tabs", "NavTabs", Model.Id == 0 ? true : Model.NavTabs == true ? true : false, "", "required", "", "text", "", 12))
									@await Html.PartialAsync("~/Views/Components/_TextCheck.cshtml",
										new Painel.Models.Components.CheckField("", "", "Mostrar Conteúdo", "ShowContent", Model.Id == 0 ? true : Model.ShowContent == true ? true : false, "", "required", "", "text", "", 12))
									@await Html.PartialAsync("~/Views/Components/_TextCheck.cshtml",
										new Painel.Models.Components.CheckField("", "", "Mostrar Detalhe do Conteúdo", "ShowContentDetailItem", Model.Id == 0 ? true : Model.ShowContentDetailItem == true ? true : false, "", "required", "", "text", "", 12))
									@await Html.PartialAsync("~/Views/Components/_TextCheck.cshtml",
										new Painel.Models.Components.CheckField("", "", "Mostrar Upload Arquivo", "ShowFileItem", Model.Id == 0 ? true : Model.ShowFileItem == true ? true : false, "", "required", "", "text", "", 12))
									@await Html.PartialAsync("~/Views/Components/_TextCheck.cshtml",
										new Painel.Models.Components.CheckField("", "", "Mostrar Upload Imagem", "ShowImageItem", Model.Id == 0 ? true : Model.ShowImageItem == true ? true : false, "", "required", "", "text", "", 12))
									@await Html.PartialAsync("~/Views/Components/_TextCheck.cshtml",
										new Painel.Models.Components.CheckField("", "", "Mostrar Pieces", "ShowPieces", Model.Id == 0 ? true : Model.ShowPieces == true ? true : false, "", "required", "", "text", "", 12))
								</div>
							</div>

						</div>
					</div>
					<div class="col-lg-6">
						<div class="card card-bordered">
							<div class="card-inner">
								<div class="row g-gs">
									@await Html.PartialAsync("~/Views/Components/_TextCheck.cshtml",
									new Painel.Models.Components.CheckField("", "", "Ativar Nome", "acNome", Model.Id == 0 ? true : Model.acNome == true ? true : false, "", "required", "", "text", "", 12))

									@await Html.PartialAsync("~/Views/Components/_TextCheck.cshtml",
										new Painel.Models.Components.CheckField("", "", "Ativar Título", "acTitulo", Model.Id == 0 ? true : Model.acTitulo == true ? true : false, "", "required", "", "text", "", 12))

									@await Html.PartialAsync("~/Views/Components/_TextCheck.cshtml",
										new Painel.Models.Components.CheckField("", "", "Ativar Subtítulo", "acSubtitulo", Model.Id == 0 ? true : Model.acSubtitulo == true ? true : false, "", "required", "", "text", "", 12))

									@await Html.PartialAsync("~/Views/Components/_TextCheck.cshtml",
										new Painel.Models.Components.CheckField("", "", "Ativar Descrição", "acDescricao", Model.Id == 0 ? true : Model.acDescricao == true ? true : false, "", "required", "", "text", "", 12))

								
								</div>

							</div>
						</div>

					</div>
					<div class="col-lg-6">
						<div class="card card-bordered">
							<div class="card-inner">
								<div class="row g-gs">

									@await Html.PartialAsync("~/Views/Components/_TextCheck.cshtml",
										new Painel.Models.Components.CheckField("", "", "Ativar Imagem", "acImagem", Model.Id == 0 ? true : Model.acImagem == true ? true : false, "", "required", "", "text", "", 12))

									@await Html.PartialAsync("~/Views/Components/_TextCheck.cshtml",
										new Painel.Models.Components.CheckField("", "", "Ativar Imagem Alt", "acImagemAlt", Model.Id == 0 ? true : Model.acImagemAlt == true ? true : false, "", "required", "", "text", "", 12))

									@await Html.PartialAsync("~/Views/Components/_TextCheck.cshtml",
										new Painel.Models.Components.CheckField("", "", "Ativar Thumbnail", "acThumbnail", Model.Id == 0 ? true : Model.acThumbnail == true ? true : false, "", "required", "", "text", "", 12))

									@await Html.PartialAsync("~/Views/Components/_TextCheck.cshtml",
										new Painel.Models.Components.CheckField("", "", "Ativar Thumbnail Alt", "acThumbnailAlt", Model.Id == 0 ? true : Model.acThumbnailAlt == true ? true : false, "", "required", "", "text", "", 12))

									
								</div>

							</div>
						</div>

					</div>
					<div class="col-lg-6">
						<div class="card card-bordered">
							<div class="card-inner">
								<div class="row g-gs">
									@await Html.PartialAsync("~/Views/Components/_TextCheck.cshtml",
									new Painel.Models.Components.CheckField("", "", "Ativar Page Title", "acPageTitle", Model.Id == 0 ? true : Model.acPageTitle == true ? true : false, "", "required", "", "text", "", 12))

									@await Html.PartialAsync("~/Views/Components/_TextCheck.cshtml",
										new Painel.Models.Components.CheckField("", "", "Ativar Slug", "acSlug", Model.Id == 0 ? true : Model.acSlug == true ? true : false, "", "required", "", "text", "", 12))

									@await Html.PartialAsync("~/Views/Components/_TextCheck.cshtml",
										new Painel.Models.Components.CheckField("", "", "Ativar Url", "acUrl", Model.Id == 0 ? true : Model.acUrl == true ? true : false, "", "required", "", "text", "", 12))

									@await Html.PartialAsync("~/Views/Components/_TextCheck.cshtml",
										new Painel.Models.Components.CheckField("", "", "Ativar Meta Description", "acMetaDescription", Model.Id == 0 ? true : Model.acMetaDescription == true ? true : false, "", "required", "", "text", "", 12))

									@await Html.PartialAsync("~/Views/Components/_TextCheck.cshtml",
										new Painel.Models.Components.CheckField("", "", "Ativar Meta Image", "acMetaImage", Model.Id == 0 ? true : Model.acMetaImage == true ? true : false, "", "required", "", "text", "", 12))

								</div>

							</div>
						</div>

					</div>
					
					<div class="col-lg-6">
						<div class="card card-bordered">
							<div class="card-inner">
								<div class="row g-gs">
									@await Html.PartialAsync("~/Views/Components/_TextCheck.cshtml",
										new Painel.Models.Components.CheckField("", "", "Ativar Categoria", "acCategoria", Model.Id == 0 ? true : Model.acCategoria == true ? true : false, "", "required", "", "text", "", 12))

									@await Html.PartialAsync("~/Views/Components/_TextCheck.cshtml",
										new Painel.Models.Components.CheckField("", "", "Ativar Ordem", "acOrdem", Model.Id == 0 ? true : Model.acOrdem == true ? true : false, "", "required", "", "text", "", 12))

									@await Html.PartialAsync("~/Views/Components/_TextCheck.cshtml",
										new Painel.Models.Components.CheckField("", "", "Ativar Destaque", "acDestaque", Model.Id == 0 ? true : Model.acDestaque == true ? true : false, "", "required", "", "text", "", 12))

									@await Html.PartialAsync("~/Views/Components/_TextCheck.cshtml",
										new Painel.Models.Components.CheckField("", "", "Ativar Exclusivo", "acExclusivo", Model.Id == 0 ? true : Model.acExclusivo == true ? true : false, "", "required", "", "text", "", 12))

									@await Html.PartialAsync("~/Views/Components/_TextCheck.cshtml",
										new Painel.Models.Components.CheckField("", "", "Ativar Ativo", "acAtivo", Model.Id == 0 ? true : Model.acAtivo == true ? true : false, "", "required", "", "text", "", 12))


								</div>

							</div>
						</div>

					</div>
				</div>

			</div>






		</div>


	</form>
</div>

