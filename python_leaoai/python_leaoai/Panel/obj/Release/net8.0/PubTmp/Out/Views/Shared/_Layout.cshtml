<!DOCTYPE html>
<html lang="pt-br">
<head>
	<meta charset="utf-8" />
	<meta name="viewport" content="width=device-width, initial-scale=1.0" />
	<title>@ViewData["Title"] - Leão Adv</title>

	<!-- StyleSheets  -->
	<link rel="stylesheet" href="/assets/css/dashlite.css?ver=2.8.0">
	<link id="skin-default" rel="stylesheet" href="/assets/css/theme.css?ver=2.8.0">
	<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/jquery-confirm/3.3.0/jquery-confirm.min.css">
	<link href="~/lib/chosen/chosen.css" rel="stylesheet" />
	
	<link rel="preconnect" href="https://fonts.googleapis.com">
	<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
	<link href="https://fonts.googleapis.com/css2?family=Roboto:ital,wght@0,100;0,300;0,400;0,500;0,700;0,900;1,100;1,300;1,400;1,500;1,700;1,900&display=swap" rel="stylesheet">


	@RenderSection("Styles", required: false)
</head>
<body class="nk-body bg-lighter npc-default has-sidebar ">
	<div id="global-loader" style=""> <img src="../../assets/images/svgs/loader.svg" alt="loader"> </div>
	<div class="nk-app-root">
		<div class="nk-main ">

			<div class="nk-sidebar nk-sidebar-fixed is-light " data-content="sidebarMenu">
				<div class="nk-sidebar-element nk-sidebar-head">
					<div class="nk-sidebar-brand">
						<a href="~/" class="logo-link nk-sidebar-logo">
							<img class="logo-light logo-img" src="../../assets/images/logo.png" srcset="../../assets/images/logo.png" alt="logo">
							<img class="logo-dark logo-img" src="../../assets/images/logo.png" srcset="../../assets/images/logo.png" alt="logo-dark">
							<img class="logo-small logo-img logo-img-small" src="../../assets/images/logo.png" srcset="../../assets/images/logo.png" alt="logo-small">
						</a>
					</div>
					<div class="nk-menu-trigger mr-n2">
						<a href="#" class="nk-nav-toggle nk-quick-nav-icon" data-target="sidebarMenu"><em class="icon ni ni-arrow-left"></em></a>
					</div>
				</div>
				@await Html.PartialAsync("~/Views/Shared/SystemViews/_MenuWrapper.cshtml")
			</div>


			<div class="nk-wrap ">

				@await Html.PartialAsync("~/Views/Shared/SystemViews/_MenuConfigs.cshtml")

				<div class="nk-content ">

					<div class="container-fluid" style="padding:0 !important">
						<div class="nk-content-inner">
							<div class="nk-content-body">

								@RenderBody()
							</div>
						</div>
					</div>
				</div>
				<div class="nk-footer">
					<div class="container-fluid">
						<div class="nk-footer-wrap">
							<div class="nk-footer-copyright">
								Powered by <a href="" target="_blank">TripleA</a>
							</div>
						
						</div>
					</div>
				</div>
			</div>


		</div>
	</div>


	<script src="/assets/js/bundle.js?ver=2.8.0"></script>
	<script src="/assets/js/scripts.js?ver=2.8.0"></script>
	<script src="/assets/js/charts/chart-ecommerce.js?ver=2.8.0"></script>

	<script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-confirm/3.3.0/jquery-confirm.min.js"></script>
	<script src="~/scripts/jquery/jquery.mask.min.js"></script>
	<script src="~/lib/chosen/chosen.jquery.min.js"></script>

	<script src="~/scripts/mask.js"></script>
	<script src="~/scripts/dropdowns.js"></script>
	<script src="~/scripts/uploads.js"></script>
	<script src="~/scripts/main.js"></script>
	<script src="~/scripts/ckeditor/ckeditor.js"></script>
	<script src="~/scripts/ckeditor5/startckeditor.js"></script>

	<script type="text/javascript">
		$(document).ready(function () {

			if ($("#Descricao").length > 0) {
				CKEDITOR.replace('Descricao', {
					filebrowserImageBrowseUrl: '/helpers/uploadPartial',
					filebrowserImageUploadUrl: '/Imagem/CKImage',
					customConfig: '~/scripts/customconfigs.js'
				});
			}
			if ($("#NossaHistoria").length > 0) {
				CKEDITOR.replace('NossaHistoria', {
					filebrowserImageBrowseUrl: '/helpers/uploadPartial',
					filebrowserImageUploadUrl: '/Imagem/CKImage',
					customConfig: '~/scripts/customconfigs.js'
				});
			}
			if ($("#SolucoesPersonalizadas").length > 0) {
				CKEDITOR.replace('SolucoesPersonalizadas', {
					filebrowserImageBrowseUrl: '/helpers/uploadPartial',
					filebrowserImageUploadUrl: '/Imagem/CKImage',
					customConfig: '~/scripts/customconfigs.js'
				});
			}
			if ($("#Industria").length > 0) {
				CKEDITOR.replace('Industria', {
					filebrowserImageBrowseUrl: '/helpers/uploadPartial',
					filebrowserImageUploadUrl: '/Imagem/CKImage',
					customConfig: '~/scripts/customconfigs.js'
				});
			}
			if ($("#Producao").length > 0) {
				CKEDITOR.replace('Producao', {
					filebrowserImageBrowseUrl: '/helpers/uploadPartial',
					filebrowserImageUploadUrl: '/Imagem/CKImage',
					customConfig: '~/scripts/customconfigs.js'
				});
			}

			$('#global-loader').fadeOut();

		});

		function updateValue(id, value) {
			document.getElementById(id).value = value;
		}

	</script>

	@RenderSection("scripts", required: false)
</body>
</html>
