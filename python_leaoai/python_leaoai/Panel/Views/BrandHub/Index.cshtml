@model List<Framework.Data.Models.xCode.ChatIA>
@using Painel.Models.Components
@{
    // ContentConfig bread = Model.ContentConfig;
    ViewData["Title"] = "Brand Hub";
}

@await Html.PartialAsync("~/Views/Components/_Alerts.cshtml")

<div class="nk-block nk-block-lg">

    <div class="nk-block-head">
        <div class="nk-block-between">
            <div class="nk-block-head-content">
                <h4 class="nk-block-title fw-normal">BrandHub</h4>
                <div class="nk-block-des">
                    <nav>
                        <ul class="breadcrumb breadcrumb-arrow">
                            <li class="breadcrumb-item"><a href="~/">Dashboard</a></li>
                            <li class="breadcrumb-item active">BrandHub</li>
                        </ul>
                    </nav>
                </div>
            </div>
            @{
                var typed = Context.Request.Query["typed"].ToString()?.ToLower();
            }
            <div class="nk-block-head-content">
                @if (typed == "manifestacaoindeferimento")
                {
                    <a href="/brandhub/ManifestacaoRecursoIndeferimento" class="btn btn-success">
                        <em class="icon ni ni-plus"></em><span>Nova Manifestação ao Recurso do Indeferimento</span>
                    </a>
                }
                else if (typed == "contrarazaonulidade")
                {
                    <a href="/brandhub/contrarrazaoNulidade" class="btn btn-success">
                        <em class="icon ni ni-plus"></em><span>Nova Contrarrazão à Nulidade</span>
                    </a>
                }
                else if (typed == "caducidade")
                {
                    <a href="/brandhub/caducidade" class="btn btn-success">
                        <em class="icon ni ni-plus"></em><span>Nova Caducidade</span>
                    </a>
                }
                else if (typed == "oposicao")
                {
                    <a href="/brandhub/oposicao" class="btn btn-success">
                        <em class="icon ni ni-plus"></em><span>Nova Oposição</span>
                    </a>
                }
                else if (typed == "manifestacao")
                {
                    <a href="/brandhub/manifestacao" class="btn btn-success">
                        <em class="icon ni ni-plus"></em><span>Nova Manifestação</span>
                    </a>
                }
                else if (typed == "nulidade")
                {
                    <a href="/brandhub/nulidade" class="btn btn-success">
                        <em class="icon ni ni-plus"></em><span>Nova Nulidade</span>
                    </a>
                }
                else if (typed == "recursoindeferimento")
                {
                    <a href="/brandhub/recursoindeferimento" class="btn btn-success">
                        <em class="icon ni ni-plus"></em><span>Novo Recurso ao Indeferimento</span>
                    </a>
                }
            </div>

        </div>
    </div>

    @* @await Html.PartialAsync("~/Views/Shared/Structure/_BreadCrumbList.cshtml", bread) *@
    <div class="card card-preview">
        <div class="card-inner">
            <table class="datatable-init-export nowrap table">
                <thead>
                    <tr>
                        <th>Id</th>
                        <th>Tipo</th>
                        <th>Processo Contestado</th>
                        <th>Marca Contestada</th>
                        <th>Classe Contestada</th>
                        <th width="10%">Ações</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>@item.Id</td>
                            <td>
                                @switch (item.Typed)
                                {
                                    case "oposicao":
                                        <div>Oposição</div>
                                        break;
                                    case "nulidade":
                                    case "Nulidade":
                                        <div>Nulidade</div>
                                        break;
                                    case "Manifestacao":
                                        <div>Manifestação à Oposição</div>
                                        break;
                                    case "RecursoIndeferimento":
                                        <div>Recurso ao Indeferimento</div>
                                        break;
                                 
                                }

                            </td>
                            <td>@item.ProcessoContestado</td>
                            <td>@item.MarcaContestada</td>
                            <td>@item.ClasseContestada</td>
                            <td>
                                <a href="@Url.Action("Oposicao", "BrandHub", new { id = item.Id })" class="btn btn-icon btn-sm btn-primary" title="Editar Registro">
                                    <em class="icon ni ni-edit"></em>
                                </a>
                                  <form method="post" asp-controller="BrandHub" asp-action="Delete" style="display:inline;">
        <input type="hidden" name="id" value="@item.Id" />
        <button type="submit" class="btn btn-icon btn-sm btn-danger" title="Deletar Registro">
            <em class="icon ni ni-trash"></em>
        </button>
    </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
