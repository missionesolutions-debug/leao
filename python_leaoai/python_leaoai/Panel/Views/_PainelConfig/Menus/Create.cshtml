@model Data.Models.PainelConfig.Menu
@{
	ViewData["Title"] = "Cadastro de Menus";
}
@using Painel.Models.Components
@{
	ContentConfig bread = new ContentConfig()
	{
		Route = "/menus",
		Post = "/menus/create",
		Tela = "Menus",
		Backplace = "Lista",
		Obs = "Preencha os campos abaixo para criar um novo registro"
	};


}

<div class="nk-block nk-block-lg">

	@await Html.PartialAsync("~/Views/Shared/Contents/_HeadContentCreate.cshtml", bread)

	<div class="card">
		<div class="card-inner">

			<form action="@bread.Post" method="post">
				<div class="row g-4">

					@Html.HiddenFor(model => model.Id)
					@Html.HiddenFor(model => model.Excluido)
					@Html.ValidationSummary(true)
					@Html.AntiForgeryToken()


					@await Html.PartialAsync("~/Views/Components/_TextField.cshtml",
						new Painel.Models.Components.TextField("Nome", "Nome", Model.Nome, "", "required", "", "text", "", 10))

					@await Html.PartialAsync("~/Views/Components/_TextField.cshtml",
						new Painel.Models.Components.TextField("RoleGate", "RoleGate", Model.RoleGate, "", "required", "PowerUser, ContentCreator, Business, ProductOwner, Ecommerce", "text", "", 10))

					@await Html.PartialAsync("~/Views/Components/_TextField.cshtml",
						new Painel.Models.Components.TextField("Ordem", "Ordem", Model.Ordem != null ? Model.Ordem.ToString() : "0", "", "", "", "text", "", 10))

					@await Html.PartialAsync("~/Views/Components/_TextCheck.cshtml",
						new Painel.Models.Components.CheckField("", "", "Ativo", "Ativo", Model.Id == 0 ? true : Model.Ativo == true ? true : false, "", "required", "", "text", "", 10))

					@await Html.PartialAsync("~/Views/Components/_FormActions.cshtml")

				</div>
			</form>
		</div>
	</div>
</div>

