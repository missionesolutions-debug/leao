                                            <a href="/chat" class="mt-auto btn btn-outline-primary">Acessar</a>
                                        </div>
                                    </div>
                                </div>

                                <div class="col-md-4">
                                    <div class="card h-100">
                                        <div class="card-body d-flex flex-column">
                                            <h4 class="mb-3">
                                                <!-- Ícone SVG -->
