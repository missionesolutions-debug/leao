@model Panel.Models.Pages.Factory.SupplierPage
@using Painel.Models.Components
@{
    ContentConfig bread = Model.ContentConfig;
    ViewData["Title"] = "Fornecedores";
}

@await Html.PartialAsync("~/Views/Components/_Alerts.cshtml")

<div class="nk-block nk-block-lg">
    @await Html.PartialAsync("~/Views/Shared/Structure/_BreadCrumbList.cshtml", bread)
    <div class="card card-preview">
        <div class="card-inner">
            <table class="datatable-init-export nowrap table" data-export-title="Export">
                <thead>
                    <tr>
                        <th>Fornecedor</th>
                        <th>Responsável</th>
                        <th>Emails</th>
                        @*    <th>CNPJ</th>
                        <th>Telefone</th>
                        *@
                        <th width="10%">Ações</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.Suppliers)
                    {
                        <tr>
                            <td>@item.Nome</td>
                            <td>@item.Responsavel</td>
                            <td>
                                @if (item.Email != null && item.Email.Length > 40)
                                {
                                    <div>@item.Email.Substring(0, 40)...</div>
                                }
                                else
                                {
                                    @item.Email
                                }
                            </td>
                            @*  <td>@item.CNPJ</td>
                        <td>@item.Telefone</td>
                        *@
                            <td>
                                <a href="@Url.Action("Create", "Suppliers", new { id = item.Id })" class="btn btn-icon btn-sm btn-primary" title="Editar Registro">
                                    <em class="icon ni ni-edit"></em>
                                </a>
                                <form method="post" style="display:inline;" action="@Url.Action("Delete", "Suppliers")">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@item.Id" />
                                    <button type="submit" class="btn btn-icon btn-sm btn-danger" title="Deletar Registro">
                                        <em class="icon ni ni-trash"></em>
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>