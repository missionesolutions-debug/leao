
<div class="modal fade show" id="modalForm" aria-modal="true" role="dialog">
	<div class="modal-dialog" role="document">
		<div class="modal-content">
			<div class="modal-header">
				<h5 class="modal-title">Novo Projeto</h5>
				<a href="#" class="close" data-dismiss="modal" aria-label="Close">
					<em class="icon ni ni-cross"></em>
				</a>
			</div>
			<div class="modal-body">
				<form action="/projects/newproject" class="form-validate is-alter" method="post" novalidate="novalidate">
					@Html.AntiForgeryToken()
					<div class="row">
						@await Html.PartialAsync("~/Views/Components/_TextField.cshtml",
							new Painel.Models.Components.TextField("Nome Projeto", "Titulo", null, "", "required", "", "text", "", 12))

						@await Html.PartialAsync("~/Views/Components/_SelectField.cshtml",
							new Painel.Models.Components.TextField("Cliente", "ClienteId", "", "", "required", "", "", "form-select", 12))

						<div class="form-group">
							<label class="form-label">Data de Início</label>
							<div class="form-control-wrap focused">
								<div class="form-icon form-icon-left">
									<em class="icon ni ni-calendar"></em>
								</div>
								<input type="text" name="DataInicio" value="" class="form-control date-picker" data-date-format="dd-mm-yyyy" required>
							</div>
							<div class="form-note">Formato <code>dd/mm/aaaa</code></div>
						</div>
						<div class="form-group">
							<label class="form-label">Data de Fim</label>
							<div class="form-control-wrap focused">
								<div class="form-icon form-icon-left">
									<em class="icon ni ni-calendar"></em>
								</div>
								<input type="text" name="DataFim" value="" class="form-control date-picker" data-date-format="dd-mm-yyyy" required>
							</div>
							<div class="form-note">Formato <code>dd/mm/aaaa</code></div>
						</div>
					</div>
					<div class="row" style="margin-top:10px">
						<div class="col-lg-12">
							<div class="form-group" >
								<button type="submit" class="btn btn-lg btn-success  text-md-center">Criar Novo Projeto</button>
							</div>
						</div>
					</div>
				</form>
			</div>
			<div class="modal-footer bg-light">
				<span class="sub-text">Os projetos serão criados com as respectivas tarefas a serem executadas</span>
			</div>
		</div>
	</div>
</div>