<div class="col-lg-@Model.Col my-2">
    <div class="form-group">
        <div class="custom-control custom-switch">

            <InputCheckbox Value="Model.Value"
                           ValueChanged="HandleValueChanged"
                           ValueExpression="@(() => Model.Value)"
                           @attributes="AdditionalAttributes"
                           class="@($"custom-control-input {Model.Class}")"
                           id="@(Model.ID ?? Model.Name)" />


            <label class="custom-control-label" for="@(Model.ID ?? Model.Name)">
                @Model.Label

                @if (Model.ContentPopover != "")
                {
                    <button type="button" class="btn btn-xs" data-bs-toggle="popover" data-bs-trigger="hover" title="@Model.Title" data-bs-content="@Model.ContentPopover">
                        <em class="icon ni ni-info"></em>
                    </button>
                }
            </label>

            @if (Model.Obs != "")
            {
                <small id="small-@Model.Name" class="form-text text-muted">@Model.Obs</small>
            }
        </div>
    </div>
</div>


@code {
    [Parameter]
    public CheckField Model { get; set; }

    [Parameter]
    public EventCallback<bool> ValueChanged { get; set; }

    private async Task HandleValueChanged(bool newValue)
    {
        Model.Value = newValue;
        await ValueChanged.InvokeAsync(Model.Value);
    }

    private Dictionary<string, object> AdditionalAttributes => new Dictionary<string, object>
    {
        { "name", Model.Name }
    };
}
