@* 
@namespace Panel.Components.RazorComponents
@using Framework.Data.Models.Conteudo
@using MudBlazor
@using Framework.Repositories
@using Panel.Components.RazorComponents.Conteudo.PageSection
@inject IRepository<PageSection> PageSectionRepository
@inject IDialogService DialogService

<h6>Seções</h6>
<MudButton Color="Color.Tertiary" OnClick="@OpenAddDialog">Adicionar Nova Seção</MudButton>

<MudExpansionPanels MultiExpansion="true">
    @foreach (var item in pageSections.OrderByDescending(b=> b.Ordem))
    {
        <MudExpansionPanel Text="@item.NameValue">
            <MudText>@item.KeyValue</MudText>
            <MudButton OnClick="@(() => OpenEditDialog(item))" Color="Color.Secondary">Editar</MudButton>
            <MudButton OnClick="@(() => DeleteSection(item))" Color="Color.Error">Excluir</MudButton>
        </MudExpansionPanel>

    }
</MudExpansionPanels>

@code {
    private List<PageSection> pageSections = new List<PageSection>();
    private PageSection currentSection;

    [Parameter]
    public int PaginaId { get; set; }

    protected override async Task OnInitializedAsync()
    {
        await ReloadSections();
    }

    private void StartNewSection()
    {
        currentSection = new PageSection { PaginaId = this.PaginaId, Ativo = true };
    }

    private async Task OpenAddDialog()
    {
        // Cria uma nova instância de PageSection com o PaginaId correto antes de abrir o diálogo
        var newSection = new PageSection { PaginaId = this.PaginaId, Ativo = true };

        var parameters = new DialogParameters
        {
            {"newSection", newSection}
        };

        var options = new DialogOptions { BackgroundClass = "my-custom-class", CloseOnEscapeKey = true, MaxWidth = MaxWidth.Medium, FullWidth = true, CloseButton = true };

        var dialog = DialogService.Show<AddPageSectionDialog>("Adicionar Nova Seção", parameters, options);
        var result = await dialog.Result;

        if (result.Data != null)
        {
            // Este código é executado apenas se o diálogo não foi cancelado e dados foram passados.
            await ReloadSections();
        }
    }


    private async Task OpenEditDialog(PageSection section)
    {
        var parameters = new DialogParameters();
        if (section != null)
        {
            parameters.Add("Section", section);
        }

        var options = new DialogOptions { BackgroundClass = "my-custom-class", CloseOnEscapeKey = true, MaxWidth = MaxWidth.Medium, FullWidth = true, CloseButton = true };

        var dialog = DialogService.Show<EditPageSectionDialog>("Editar Seção", parameters, options);
        var result = await dialog.Result;

        if (result.Data != null)
        {
            // Este código é executado apenas se o diálogo não foi cancelado e dados foram passados.
            await ReloadSections();
        }
    }

    private async Task DeleteSection(PageSection section)
    {
        await PageSectionRepository.RemoveObjAsync(section);
        await ReloadSections();
    }

    private async Task ReloadSections()
    {
        pageSections = await PageSectionRepository.GetAllAtivoAsync();
        StateHasChanged();
    }
}

 *@