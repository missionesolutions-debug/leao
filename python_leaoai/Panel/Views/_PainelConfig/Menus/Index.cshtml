@model List<Data.Models.PainelConfig.Menu>
@using Painel.Models.Components
@{
	ContentConfig bread = new ContentConfig()
	{
		Route = "/menus/create",
		Post = "/menus/create",
		DeleteRoute = "/menus/delete",
		Tela = "Menus"
	};
}

@await Html.PartialAsync("~/Views/Components/_Alerts.cshtml")

<div class="components-preview  mx-auto">
	<div class="nk-block nk-block-lg">
		@await Html.PartialAsync("~/Views/Shared/Contents/_BreadCrumbList.cshtml", bread)

		<div class="card card-preview">
			<div class="card-inner">
				<table class="datatable-init-export nowrap table" data-export-title="Export">
					<thead>
						<tr>
							<th width="8%">ID</th>
							<th>Nome</th>
							<th>Role</th>
							<th>Ordem</th>
							<th width="8%">Status</th>
							<th width="10%">Ações</th>
						</tr>
					</thead>
					<tbody>
						@foreach (var item in Model)
						{
						<tr>
							<td>@item.Id</td>
							<td>@item.Nome</td>
							<td>@item.RoleGate</td>
							<td>@item.Ordem</td>
							<td>
								@await Html.PartialAsync("~/Views/Components/_AtivoReturn.cshtml", item.Ativo)
							</td>
							<td class="nk-tb-col nk-tb-col-tools">
								<ul class="nk-tb-actions gx-1 ">
									<li>
										<a href="@String.Format("{0}/{1}",bread.Post,item.Id)" class="btn btn-icon btn-sm btn-primary" title="Editar Registro"><em class="icon ni ni-edit"></em></a>
									</li>
									<li>
										<form method="post" id="form-@item.Id" action="@String.Format("{0}/{1}",bread.DeleteRoute,item.Id)">
											<button type="button" onclick="callDelete(this,@item.Id);" style="border:none;" class="btn btn-icon btn-sm btn-danger" title="Deletar Registro"><em class="icon ni ni-trash"></em></button>
										</form>
									</li>

								</ul>
							</td>
						</tr>
						}
					</tbody>
				</table>
			</div>
		</div>
	</div>
</div>