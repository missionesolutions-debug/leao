@model Painel.Models.Components.TextField


<div class="col-lg-@Model.Col">
	<div class="form-group">
		<label class="form-label" for="@Model.Name">@Model.Label @(Model.Required.Length > 0 ? "*" : "")</label>
	
		<div class="form-control-wrap custom-file">
			<input type="file" data-id="@Model.Name" class="image-upload custom-file-input uploader-@Model.Name" style="@(Model.Value != null ? "display:none !important" : "display:block !important")" />
			<label class="form-label custom-file-label" for="@Model.Name">Escolha o arquivo</label>
			<input type="hidden" id="@Model.Name" name="@Model.Name" value="@Model.Value" />
			@if (Model.Obs != "")
			{
				<small id="small-@Model.Name" class="form-text text-muted">@Model.Obs</small>
			}
		</div>

		<div class="card bl-@Model.Name" style="@(Model.Value != null ? "display:block;width: 100%; margin:0 auto;max-width:442px;margin-top:10px" : "display:none;width: 100%; margin:0 auto;max-width:442px;margin-top:10px")">
			<img src="@(Model.Value != null ? Model.Value : "")" alt="100%x280" style="max-width: 442px; width: 100%;" data-holder-rendered="true">
			<div class="card-body">
				<a title="Excluir" class="btn-danger btn btn-sm btn-grid remover-img" data-id="@Model.Name" data-toggle="tooltip" data-title="Excluir" href="javascript:void(0);">
					<i class="fa fa-trash"></i> Remover Imagem
				</a>
			</div>
		</div>
	</div>
</div>


