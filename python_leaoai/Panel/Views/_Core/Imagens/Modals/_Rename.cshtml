
<div class="modal fade show" id="modalForm" aria-modal="true" role="dialog">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content">
            <a href="#" class="close" data-dismiss="modal">
                <em class="icon ni ni-cross-sm"></em>
            </a>
            <div class="modal-body modal-body-md">
                <h5 class="modal-title">Editar Imagem</h5>
                <form action="/imagens/rename" class="form-validate is-alter" method="post" novalidate="novalidate">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="Id" value="" id="RenameId" />

                    <div class="row g-gs">

                        @await Html.PartialAsync("~/Views/Components/_TextField.cshtml",
                        new Painel.Models.Components.TextField("Nome do Arquivo", "Titulo", "", "", "", "", "text", "", 6))

                        <div class="col-md-6">
                            <div class="form-group">
                                <label class="form-label" for="editAlt">Alt Imagem</label>
                                <input type="text" class="form-control" id="Alt" placeholder="Alt Imagem" value="" name="Alt">
                            </div>
                        </div>

                        @await Html.PartialAsync("~/Views/Components/_TextField.cshtml",
                                 new Painel.Models.Components.TextField("Descrição", "DescriptionFile", "", "", "", "", "text", "", 12))
                        
                        <div class="col-md-12">
                            <div class="form-group">
                                <label class="form-label" for="category">Imagem</label>
                                <div class="form-control-wrap">
                                    <img id="imgDestaque" src="" style="max-height:300px" alt="">
                                </div>
                            </div>
                        </div>
                        <div class="col-12">
                            <ul class="align-center flex-wrap flex-sm-nowrap gx-4 gy-2">
                                <li>
                                    <button type="submit" class="btn btn-lg btn-success  text-md-center">Editar Arquivo</button>
                                </li>
                            </ul>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

