@model Painel.Models.Pages.Core.ArquivoPage

@using Painel.Models.Components
@{
	ContentConfig bread = Model.ContentConfig;
	bread.Id = Model.Id;
	if (Model.Tab is not null)
	{
		bread.Table = Model.Tab;
		bread.Post = bread.Post.Replace("arquivos", Model.Tab.ToLower());
	}
	if (Model.Tab is null)
	{
		bread.Table = "";
		bread.NavTabs = false;
	}
	bread.NavTabsConfig.ShowContentDetailItem = false;
}

@{
	ViewData["Title"] = "Cadastro de " + bread.Tela;
}


@await Html.PartialAsync("~/Views/Components/_Alerts.cshtml")

<div class="nk-block nk-block-lg">

	@await Html.PartialAsync("~/Views/Shared/Structure/_HeadContent.cshtml", bread)

	@if (bread.NavTabs == true)
	{
		@await Html.PartialAsync("~/Views/Shared/Structure/_NavTabs.cshtml", bread)
	}

	<div class="tab-content">
		<div class="tab-pane active" id="tabItem5">
			<form action="/arquivos/upload" method="post" enctype="multipart/form-data">

				<div class="row g-gs">
					<div class="col-lg-12">
						<div class="card card-bordered">
							<div class="card-inner">

								<input type="hidden" name="Id" value="@Model.Id" />
								<input type="hidden" name="Tab" value="@Model.Tab" />

								@Html.ValidationSummary(true)
								@Html.AntiForgeryToken()

								<div class="row g-gs">
									<div class="col-md-12">
										<div class="form-group">
											<div class="form-control-wrap">
												<div class="custom-file">
													<input type="file" multiple class="custom-file-input" id="customMultipleFiles" name="files">
													<label class="custom-file-label" for="customMultipleFiles">Selecione os arquivos</label>
												</div>
											</div>
										</div>
									</div>
									<div class="col-12">
										<div class="form-group">
											<button type="submit" style="width:100% !important;text-align:center !important;display:block !important;" class="btn btn-lg btn-success">Enviar</button>
										</div>
									</div>

								</div>
							</div>
						</div>
					</div>
				</div>
			</form>
		</div>
	</div>

</div>


@if (Model.Arquivos != null && Model.Arquivos.Count > 0)
{
	<div class="nk-fmg-body">
		<div class="nk-fmg-body-content">
			<div class="nk-fmg-listing nk-block">
				<div class="nk-files nk-files-view-grid">
					<div class="nk-files-group">
						<div class="nk-files-list">
							@foreach (var item in Model.Arquivos)
							{
								@await Html.PartialAsync("~/Views/_Core/Arquivos/_FileItem.cshtml", item)
							}
						</div>
					</div>
				</div>
			</div>
		</div>
	</div>
}

@if (Model.Arquivos != null && Model.Arquivos.Count == 0)
{
	<div class="nk-fmg-body">
		<div class="nk-fmg-body-content">
			<div class="nk-fmg-listing nk-block">
				<div class="nk-files nk-files-view-grid">
					<div class="nk-files-group">
						<h6 class="title">Arquivos</h6>
						<p>Nenhum arquivo registrado.</p>
					</div>
				</div>
			</div>
		</div>
	</div>
}


@await Html.PartialAsync("~/Views/_Core/Arquivos/Modals/_Rename.cshtml", bread)


@section scripts{

	<script type="text/javascript">
		$(document).ready(function () {
			$('.btn-renomear-arquivo').click(function () {
				$('#modalForm').modal('show');
				$("#RenameId").val($(this).data('id'));
				$("#FileTags").val($(this).data('tags'));
				$("#Titulo").val($(this).data('name'));
				$("#Descricao").val($(this).data('descricao'));
			})
		});
	</script>

}
