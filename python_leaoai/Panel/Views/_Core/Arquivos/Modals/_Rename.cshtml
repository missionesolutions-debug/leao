
<div class="modal fade show" id="modalForm" aria-modal="true" role="dialog">
	<div class="modal-dialog" role="document">
		<div class="modal-content">
			<div class="modal-header">
				<h5 class="modal-title">Renomear</h5>
				<a href="#" class="close" data-dismiss="modal" aria-label="Close">
					<em class="icon ni ni-cross"></em>
				</a>
			</div>
			<div class="modal-body">
				<form action="/arquivos/rename" class="form-validate is-alter" method="post" novalidate="novalidate">
					@Html.AntiForgeryToken()
					<input type="hidden" name="Id" value="" id="RenameId" />

					<div class="row">
						@await Html.PartialAsync("~/Views/Components/_TextField.cshtml",
							new Painel.Models.Components.TextField("Nome do Arquivo", "Titulo", null, "", "required", "", "text", "", 12))
					</div>
					<div class="row">
						@await Html.PartialAsync("~/Views/Components/_TextArea.cshtml",
							new Painel.Models.Components.TextField("Descrição", "Description", null, "", "", "", "text", "", 12))
					</div>
					<div class="row">
						@await Html.PartialAsync("~/Views/Components/_TextField.cshtml",
							new Painel.Models.Components.TextField("Tags do Arquivo", "FileTags", null, "", "", "Separar as tags por vírgula", "text", "", 12))
					</div>
					<div class="row" style="margin-top:10px">
						<div class="col-lg-12">
							<div class="form-group">
								<button type="submit" class="btn btn-lg btn-success  text-md-center">Renomear Arquivo</button>
							</div>
						</div>
					</div>
				</form>
			</div>
		</div>
	</div>
</div>


