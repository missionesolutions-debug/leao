@model Painel.Models.Components.ContentConfig

<div class="nk-block-head">
	<div class="nk-block-between">
		<div class="nk-block-head-content">
			<h4 class="nk-block-title fw-normal">@Model.Tela</h4>
			<div class="nk-block-des">
				<nav>
					<ul class="breadcrumb breadcrumb-arrow">
						<li class="breadcrumb-item"><a href="~/">Dashboard</a></li>
						<li class="breadcrumb-item active">@Model.Tela</li>
					</ul>
				</nav>
			</div>
		</div>
		<div class="nk-block-head-content">
			@if (Model.ModalForm is true)
			{
				<button type="button" class="btn btn-success" data-toggle="modal" data-target="#modalForm"><em class="icon ni ni-plus"></em><span>Novo Registro</span></button>
			}
			else
			{
				<a href="@Model.Post" class="btn btn-success"><em class="icon ni ni-plus"></em><span>Novo Registro</span></a>
			}
		</div>
	</div>
</div>