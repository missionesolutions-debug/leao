@model Panel.Models.BrandsHub.ContraRazaoNulidadeRequestModel
@{
    ViewData["Title"] = "Contrarrazão à Nulidade";
}

@if (ViewBag.Prompt != null)
{
    <div class="nk-content">
        <div class="container-fluid">
            <div class="nk-content-inner">
                <div class="nk-content-body">
                    <div class="nk-block">
                        <div class="card">
                            <div class="card-inner">

                                <!-- Abas -->
                                <ul class="nav nav-tabs" id="contrarazaoTabs" role="tablist">
                                    <li class="nav-item" role="presentation">
                                        <a class="nav-link active" id="peticao-tab" data-bs-toggle="tab" href="#peticao" role="tab">Contra-Razão Gerada</a>
                                    </li>
                                    <li class="nav-item" role="presentation">
                                        <a class="nav-link" id="historico-tab" data-bs-toggle="tab" href="#historico" role="tab">Histórico do Chat</a>
                                    </li>
                                </ul>

                                <div class="tab-content pt-4" id="contrarazaoTabsContent">
                                    <div class="tab-pane fade show active" id="peticao" role="tabpanel">
                                        <h4 class="nk-block-title page-title">Contra-Razão Gerada</h4>
                                        <p class="text-muted mb-4">Revise o conteúdo abaixo. Caso deseje, adicione observações e reenviar para gerar nova versão.</p>

                                        <div id="prompt-box" class="border rounded p-3 mb-3">
                                            @Html.Raw(ViewBag.Prompt.Replace("```html", "").Replace("```", ""))
                                        </div>

                                        <form asp-action="ContraRazaoNulidadeRepost" asp-controller="BrandHub" method="post">
                                            <input type="hidden" name="PromptAnterior" value="@ViewBag.Prompt" />
                                            <input type="hidden" name="ChatIAId" value="@ViewBag.ChatId" />
                                            <div class="form-group">
                                                <label for="Observacoes">Observações adicionais</label>
                                                <textarea class="form-control" name="Observacoes" rows="5" placeholder="Inclua sugestões, correções ou informações complementares..."></textarea>
                                            </div>
                                            <button type="submit" class="btn btn-primary mt-3">Reenviar com Observações</button>
                                        </form>
                                    </div>

                                    <div class="tab-pane fade" id="historico" role="tabpanel">
                                        <div id="chat-history">
                                            <h4 class="nk-block-title page-title">Oráculo Leão</h4>
                                            <div id="chat-box" class="border rounded p-3 mb-3">
                                                @foreach (var msg in Model.ListMessages.messageChatResponses.Where(b => b.IsChatAnswer))
                                                {
                                                    var unixTime = long.TryParse(msg.Time, out var t) ? t : 0L;
                                                    var formattedTime = DateTimeOffset.FromUnixTimeSeconds(unixTime).LocalDateTime.ToString("dd MMM, yyyy h:mm tt");
                                                    <div class="message @(msg.IsChatAnswer ? "bot" : "user")">
                                                        <strong>@(msg.IsChatAnswer ? "Oráculo Leão:" : "Você:")</strong> @Html.Raw(msg.Message)
                                                        <br /><small class="text-muted" style="font-size: 0.8em;">@formattedTime</small>
                                                    </div>
                                                }
                                            </div>
                                            <button id="open-diff-modal" class="btn btn-primary">Comparar Últimas Mensagens</button>
                                            <div id="diffModal" style="display:none; position:fixed; top:0; left:0; width:100%; height:100%; background:rgba(0,0,0,0.6); z-index:1000;">
                                                <div style="background:#fff; width:90%; height:90%; margin:5% auto; padding:20px; border-radius:8px; position:relative;">
                                                    <button id="close-diff-modal" style="position:absolute; top:10px; right:10px;">Fechar</button>
                                                    <div style="display:flex; gap:10px; height:100%;">
                                                        <div id="leftText" style="width:50%; overflow-y:scroll; border:1px solid #ccc; padding:10px; white-space:pre-wrap;"></div>
                                                        <div id="rightText" style="width:50%; overflow-y:scroll; border:1px solid #ccc; padding:10px; white-space:pre-wrap;"></div>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div> <!-- tab-content -->

                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
}
else
{
    <div class="nk-content">
        <div class="nk-content-inner">
            <div class="nk-block-head">
                <div class="nk-block-between">
                    <div class="nk-block-head-content">
                        <h4 class="nk-block-title fw-normal">Contra-Razão à Nulidade</h4>
                        <ul class="breadcrumb breadcrumb-arrow">
                            <li class="breadcrumb-item"><a href="~/">Dashboard</a></li>
                            <li class="breadcrumb-item"><a href="~/">Hub de Marcas</a></li>
                            <li class="breadcrumb-item"><a href="/brandhub?typed=contrarrazao">Contrarrazões</a></li>
                            <li class="breadcrumb-item active">Contra-Razão</li>
                        </ul>
                    </div>
                </div>
            </div>
            <div class="nk-content-body">
                <div class="nk-block">
                    <div class="card">
                        <div class="card-inner">
                            <h4 class="nk-block-title page-title">Contrarrazão à Nulidade</h4>
                            <p class="text-muted mb-4">Forneça os dados solicitados abaixo para geração da contra-razão à nulidade de marca.</p>

                            <form asp-action="contrarazaoNulidade" asp-controller="BrandHub" method="post">
                                <div class="row">
                                    @* Grupo 1 *@
                                    <div class="col-md-6">
                                        <label class="form-label" asp-for="Cliente">Cliente</label>
                                        <input class="form-control" asp-for="Cliente" />
                                    </div>
                                    <div class="col-md-6">
                                        <label class="form-label" asp-for="Classe">Classe</label>
                                        <input class="form-control" asp-for="Classe" />
                                    </div>
                                    <div class="col-md-6">
                                        <label class="form-label" asp-for="Titular">Titular</label>
                                        <input class="form-control" asp-for="Titular" />
                                    </div>
                                    <div class="col-md-12">
                                        <label class="form-label" asp-for="Especificacoes">Especificações</label>
                                        <textarea class="form-control" asp-for="Especificacoes"></textarea>
                                    </div>
                                    @* Grupo 2 *@
                                    <div class="col-md-6">
                                        <label class="form-label" asp-for="Numero">Número</label>
                                        <input class="form-control" asp-for="Numero" />
                                    </div>
                                    <div class="col-md-6">
                                        <label class="form-label" asp-for="Data"></label>
                                        <input type="date" class="form-control" asp-for="Data" />
                                    </div>
                                    <div class="col-md-6">
                                        <label class="form-label" asp-for="MarcaTerceiro">Marca de terceiro</label>
                                        <input class="form-control" asp-for="MarcaTerceiro" />
                                    </div>
                                    <div class="col-md-6">
                                        <label class="form-label" asp-for="ProcessoTerceiro">Processo de terceiro</label>
                                        <input class="form-control" asp-for="ProcessoTerceiro" />
                                    </div>
                                    <div class="col-md-6">
                                        <label class="form-label" asp-for="MarcaRequerida">Marca Requerida</label>
                                        <input class="form-control" asp-for="MarcaRequerida" />
                                    </div>
                                    <div class="col-md-6">
                                        <label class="form-label" asp-for="ProcessoRequerido">Processo requerido</label>
                                        <input class="form-control" asp-for="ProcessoRequerido" />
                                    </div>
                                    <div class="col-md-6">
                                        <label class="form-label" asp-for="MarcaCliente">Marca do Cliente</label>
                                        <input class="form-control" asp-for="MarcaCliente" />
                                    </div>
                                    <div class="col-md-12">
                                        <label class="form-label" asp-for="ComentarSobreDiferencaEntreMarcas">Comentar sobre a diferença entre as marcas</label>
                                        <textarea class="form-control" asp-for="ComentarSobreDiferencaEntreMarcas"></textarea>
                                    </div>
                                    <div class="col-md-12">
                                        <label class="form-label" asp-for="PlanilhaMarcasSimilares">Planilha marcas similares</label>
                                        <textarea class="form-control" asp-for="PlanilhaMarcasSimilares"></textarea>
                                    </div>
                                    <div class="col-md-12">
                                        <label class="form-label" asp-for="ComentarSobreDistincaoEntreProdutoServico">Comentar sobre a distinção entre produto e serviço</label>
                                        <textarea class="form-control" asp-for="ComentarSobreDistincaoEntreProdutoServico"></textarea>
                                    </div>
                                </div>
                                <button type="submit" class="btn btn-primary mt-3">Enviar</button>
                            </form>

                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
}