@{
    ViewData["Title"] = "Panda Vídeo";
}

<div class="container-fluid my-5">
    <div class="row">
        <!-- Card Início -->
        <div class="col-md-4">
            <div class="card text-center">
                <div class="card-body">
                    <img src="https://cdn.prod.website-files.com/657080a54d9587b0775e39bc/6577259a0f9051141fa606c6_Transparent.svg" alt="Início Icon" class="card-icon" style="
    background-color: #ccc;
    height: 67px;
">
                    <form method="post" action="/pandavideo"><button type="submit" class="btn btn-primary">Atualizar Vídeos</button></form>
                </div>
            </div>
        </div>

    </div>
</div>


