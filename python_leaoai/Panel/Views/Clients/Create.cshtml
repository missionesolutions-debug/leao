@model Panel.Models.Pages.Factory.ClientPage
@using Painel.Models.Components
@{
    ContentConfig bread = Model.ContentConfig;
    bread.Id = Model.Client.Id;
    ViewData["Title"] = "Cadastro de Cliente";
}

<div class="nk-block nk-block-lg">
    <div class="nk-block-head-content">
        <h4 class="nk-block-title fw-normal">@Model.ContentConfig.Nome</h4>
        <div class="nk-block-des">
            <nav>
                <ul class="breadcrumb breadcrumb-arrow">
                    <li class="breadcrumb-item"><a href="~/">Dashboard</a></li>
                    <li class="breadcrumb-item"><a href="~/clients">Clientes</a></li>
                    <li class="breadcrumb-item active">@Model.ContentConfig.Nome</li>
                </ul>
            </nav>
        </div>
        <div class="nk-block-des">
            <p class="lead">@Model.ContentConfig.Obs</p>
        </div>
    </div>

    <div class="card card-bordered">
        <div class="card-inner">
            <form action="@Url.Action("Create", "Clients")" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="Id" value="@Model.Client.Id" />
                <input type="hidden" name="DataCriacao" value="@Model.Client.DataCriacao" />
                <div class="row g-gs">
                    <div class="col-md-6">
                        <label class="form-label">Nome</label>
                        <input type="text" name="Nome" class="form-control" value="@Model.Client.Nome" required />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Email</label>
                        <input type="text" name="email" class="form-control" value="@Model.Client.Email" />
                        <small>Caso tenha mais de um e-mail, informe com ; a cada email, exemplo: contato@fornecedor.com.br;tecnico@fornecedor.com.br</small>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Porcentagem de (Caixas) a serem abertas</label>
                        <input type="text" name="PorcentagemCaixas" class="form-control number-mask" value="@Model.Client.PorcentagemCaixas" required />
                        <small>Atribuir apenas números</small>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Porcentagem de (Caixas) a serem montados</label>
                        <input type="text" name="PorcentagemCaixasMontadas" class="form-control number-mask" value="@Model.Client.PorcentagemCaixasMontadas" required />
                        <small>Atribuir apenas números</small>
                    </div>
                  @*   <div class="col-md-6">
                        <label class="form-label">CNPJ</label>
                        <input type="text" name="CNPJ" class="form-control" value="@Model.Client.CNPJ" required />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Endereço</label>
                        <input type="text" name="Endereco" class="form-control" value="@Model.Client.Endereco" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Telefone</label>
                        <input type="text" name="Telefone" class="form-control" value="@Model.Client.Telefone" />
                    </div>
                  
                    <div class="col-md-6">
                        <label class="form-label">CEP</label>
                        <input type="text" name="CEP" class="form-control" value="@Model.Client.CEP" />
                    </div> *@
                    <div class="col-md-12" style="margin-top:15px;">
                        <button type="submit" class="btn btn-lg btn-success">Salvar</button>
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>
