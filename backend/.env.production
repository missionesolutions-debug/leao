# Configuração de Produção - Digital Ocean
# Copie este arquivo para backend/app/.env no servidor

# 🗄️ Banco de dados PostgreSQL
DATABASE_URL=postgresql://leaoai:SUA_SENHA_AQUI@localhost:5432/leaoai_prod

# 🤖 OpenAI API Key
OPENAI_API_KEY=sk-sua-chave-openai-aqui

# 🔐 JWT Secret Key (gere uma chave forte)
SECRET_KEY=sua-chave-secreta-jwt-minimo-32-caracteres-aqui

# 🐞 Debug (sempre False em produção)
DEBUG=False

# 🌐 Configurações do servidor
CORS_ORIGINS=["https://www.leaoai.com.br","http://www.leaoai.com.br"]

# 📊 Configurações de Performance
MAX_WORKERS=4
POOL_SIZE=20
MAX_OVERFLOW=30
POOL_TIMEOUT=30

# ⚡ Rate Limiting
RATE_LIMIT_PER_MINUTE=5

# 📝 Logging
LOG_LEVEL=INFO