@model Data.Models.Core.Arquivo
@using Framework.Tools;


<div class="nk-file-item nk-file">
	<div class="nk-file-info">
		<div class="nk-file-title">
			<div class="nk-file-icon">
				<a class="nk-file-icon-link" href="@String.Format("{0}/{1}",Model.PlaceReceived,Model.FileData)" target="_blank">
					<span class="nk-file-icon-type">
						@await Html.PartialAsync("~/Views/Shared/Structure/FileTypes/_FileSwitch.cshtml", Model.FileType)
					</span>
				</a>
			</div>
			<div class="nk-file-name">
				<div class="nk-file-name-text">
					<a href="@String.Format("{0}/{1}",Model.PlaceReceived,Model.FileData)" target="_blank" class="title">
						@if (Model.FileName is not null)
						{
							@String.Format("{0}", Model.FileName)
						}
						@if (Model.FileName is null)
						{
							@String.Format("{0}", Model.FileData)
						}
					</a>
				</div>
			</div>
		</div>
		<ul class="nk-file-desc">
			<li class="date">@Model.DataCriacao</li>
			<li class="size">@(Model.FileSize.ToInt() / 1000) KB</li>
		</ul>
	</div>
	<div class="nk-file-actions">
		<div class="dropdown">
			<a href="" class="dropdown-toggle btn btn-sm btn-icon btn-trigger" data-toggle="dropdown"><em class="icon ni ni-more-h"></em></a>
			<div class="dropdown-menu dropdown-menu-right">
				<ul class="link-list-plain no-bdr">
					<li><a href="@Model.FileData.Contains("https://") ? Model.FileData : @String.Format(" {0} /{1}",Model.PlaceReceived,Model.FileData)" target="_blank" class="file-dl-toast"><em class="icon ni ni-download"></em><span>Download</span></a></li>
					<li>
						<button type="button" class="btn-renomear-arquivo file-dl-toast" data-toggle="modal" data-target="#modalForm" data-tags="@Model.FileTags" data-name="@Model.FileName" data-id="@Model.Id" data-descricao="@Model.Description"><em class="icon ni ni-pen"></em><span>Renomear</span></button>
					</li>
					<li>
						<form method="post" id="form-@Model.Id" action="@String.Format("{0}{1}","/arquivos/delete?Id=",Model.Id)">
							<button type="button" onclick="callDelete(this,@Model.Id);" style="border:none;" class="file-dl-toast" title="Deletar Registro"><em class="icon ni ni-trash"></em><span>Deletar</span></button>
						</form>
					</li>
				</ul>
			</div>
		</div>
	</div>
</div>
