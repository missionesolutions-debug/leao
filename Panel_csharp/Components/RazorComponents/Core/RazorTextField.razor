<div class="col-lg-@Model.Col">
    <div class="form-group">
        <label class="form-label" for="@Model.Name">@Model.Label</label>
        <div class="form-control-wrap">
            <InputText type="@Model.Tipo"
                       class="@($"form-control {Model.Class}")"
                       id="@Model.Name"
                       name="@Model.Name"
                       placeholder="@Model.Placeholder"
                       @attributes="AdditionalAttributes"
                       Value="@Model.Value"
                       ValueExpression="@(() => Model.Value)"
                       ValueChanged="(e) => HandleValueChanged(e)" />
            @if (Model.Obs != "")
            {
                <small id="small-@Model.Name" class="form-text text-muted">@((MarkupString)Model.Obs)</small>
            }
        </div>
    </div>
</div>

@code {
    [Parameter]
    public TextField Model { get; set; }

    [Parameter]
    public EventCallback<string> ValueChanged { get; set; }

    private async Task HandleValueChanged(string newValue)
    {
        Model.Value = newValue;
        await ValueChanged.InvokeAsync(Model.Value);
    }

    private Dictionary<string, object> AdditionalAttributes => new Dictionary<string, object>
    {
        { "name", Model.Name },
        { "required", Model.Required}
    };
}
